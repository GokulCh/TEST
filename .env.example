# ─────────────────────────────────────────────────────────
# Ranked Bedwars Configuration Panel — Environment Variables
# ─────────────────────────────────────────────────────────

# ── Discord OAuth2 App ────────────────────────────────────
# Create at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Full URL of this app + /api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── Session ───────────────────────────────────────────────
# Any long random string (openssl rand -hex 32)
SESSION_SECRET=changeme_use_openssl_rand_hex_32

# ── Database API (Ranked-Bedwars-Database-Go) ─────────────
DATABASE_API_URL=http://127.0.0.1:8080
DATABASE_API_KEY=

# ── Next.js ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
